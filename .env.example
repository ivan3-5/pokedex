# Django Secret Key
SECRET_KEY=your-secret-key-here # Generate a secret key using this command `python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'`

# Debug mode (True or False)
DEBUG=True

# OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret